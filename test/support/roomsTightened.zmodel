// The same rooms with one policy tightened: only a room's creator may read
// its messages. Stands in for a deploy that changes a read rule.

model rooms {
    id        String         @id @default(uuid())
    name      String
    creatorId String?
    // Required, and withheld from everyone but the creator.
    inviteCode String    @allow('read', auth().id == creatorId)
    createdAt DateTime @db.Timestamptz(6)
    updatedAt DateTime @db.Timestamptz(6)
    deletedAt DateTime? @db.Timestamptz(6)
    members   roomMembers[]  @relation("roomMembers")
    messages  roomMessages[] @relation("roomMessages")

    @@allow('read', members?[userId == auth().id])
    @@allow('update', members?[userId == auth().id])
}

model roomMembers {
    id        String    @id @default(uuid())
    userId    String
    createdAt DateTime @db.Timestamptz(6)
    updatedAt DateTime @db.Timestamptz(6)
    deletedAt DateTime? @db.Timestamptz(6)
    room      rooms?    @relation("roomMembers", fields: [roomId], references: [id], onDelete: SetNull)
    roomId    String?

    @@allow('read', auth().id == userId)
}

model roomMessages {
    id        String    @id @default(uuid())
    text      String
    createdAt DateTime @db.Timestamptz(6)
    updatedAt DateTime @db.Timestamptz(6)
    deletedAt DateTime? @db.Timestamptz(6)
    room      rooms?    @relation("roomMessages", fields: [roomId], references: [id], onDelete: SetNull)
    roomId    String?

    @@allow('read', room.creatorId == auth().id)
    // The store creates the row before it links the room, so a write rule
    // over the relation would reject every post; who may read is the point.
    @@allow('create,update', auth() != null)
}
